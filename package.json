{
  "name": "app",
  "version": "1.0.0",
  "description": "Firewall rules orchestration API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main/index.js",
    "dev": "tsx watch --env-file-if-exists=.env.dev src/main/index.ts",
    "test": "node --env-file-if-exists=.env.dev node_modules/jest/bin/jest.js",
    "test:coverage": "node --env-file-if-exists=.env.dev node_modules/jest/bin/jest.js --coverage",
    "db:seed": "tsx --env-file-if-exists=.env.dev scripts/mock_data_population.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
